# ==============================================================================
# Progressive Credential Loading (PCL) Configuration
# Repository: k8s-admission-webhook-from-scratch
# ==============================================================================
#
# TIER 1: ZERO-SETUP / LOCAL DEV / CI (Default)
# - TLS certificates loaded from /etc/webhook/certs or specified CERT_DIR.
# - Validates and mutates Pod specs via standard Kubernetes AdmissionReview API.
# - Live dynamic certificate reloader watches cert directory without restarts.
#
# TIER 2: PRODUCTION KUBERNETES DEPLOYMENT
# - Point CERT_DIR or TLS_CERT_PATH / TLS_KEY_PATH to cert-manager mounted secrets.
#
# CERT_DIR=/etc/webhook/certs
# TLS_CERT_PATH=/etc/webhook/certs/tls.crt
# TLS_KEY_PATH=/etc/webhook/certs/tls.key
# PORT=8443
